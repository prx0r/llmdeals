---
import Base from '../layouts/Base.astro';
import derived from '../data/deals-derived.json';

const routeRows = derived.deals.filter(d => d.kind === 'route');
const offerRows = derived.deals.filter(d => d.kind === 'offer');

const topDeals = [
  {rank:1,slug:"opencode-go-mimo-v2.5",title:"OpenCode Go + MiMo-V2.5",tagline:"Best overall deal right now",whatYouGet:"Pay $10/month, get $60 of API usage. That is $60 worth of MiMo-V2.5 coding model calls for every $10 you spend.",realNumbers:"MiMo-V2.5 gets you ~150,000 typical requests per month. First month is only $5.",howToGetIt:"Sign up at opencode.ai/go, subscribe to Go, start using MiMo-V2.5.",whyItsGood:"MiMo is a genuinely strong coding model. The usage allowance is 6x what you pay - unusual for any AI subscription.",catch:"OpenCode can change limits or model lineup at any time.",bestFor:"People who run coding agents or write a lot of code with AI.",source:"https://opencode.ai/docs/go/"},
  {rank:2,slug:"opencode-go-hy3",title:"OpenCode Go + HY3",tagline:"Best for agent orchestration",whatYouGet:"Same $10/month plan, but HY3 is a cheaper-to-run model. You get ~21,500 requests/month of orchestration and planning.",realNumbers:"HY3 costs $0.10/M input vs MiMo at $0.14/M, so your $60 allowance stretches further.",howToGetIt:"Same Go subscription. Select HY3 as your model.",whyItsGood:"Best cheap orchestration model available. Great for routing tasks between other models.",catch:"HY3 is a specialist - not good for general coding.",bestFor:"Multi-agent systems, task routing, planning.",source:"https://opencode.ai/docs/go/"},
  {rank:3,slug:"gemini-free",title:"Gemini API Free",tagline:"Best completely free option",whatYouGet:"Use Google Gemini models for free. Input and output are both $0. Access to models with up to 1M token context windows.",realNumbers:"No monthly fee. Free within your project rate limits. If you exceed, you pay standard rates.",howToGetIt:"Create a Google AI Studio account at ai.google.dev. Start using the API immediately.",whyItsGood:"Huge context windows (1M tokens) at zero cost. Hard to beat for experimentation.",catch:"Rate limits vary by model and project. Not guaranteed for production.",bestFor:"Learning, prototyping, experimenting with large contexts.",source:"https://ai.google.dev/gemini-api/docs/pricing"},
  {rank:4,slug:"groq-free",title:"GroqCloud Free",tagline:"Best speed at zero cost",whatYouGet:"Use Groq extremely fast inference hardware for free. Each model has its own rate limits (RPM, RPD, TPM).",realNumbers:"GPT-OSS 120B: 30 requests/min, 1,000/day. Llama 3.3 70B: 30 RPM, 1,000 RPD.",howToGetIt:"Sign up at console.groq.com. No credit card needed.",whyItsGood:"Fastest inference available. Good for testing or low-volume production.",catch:"Rate limits are tight. Not for heavy usage.",bestFor:"Speed-critical prototyping, model testing.",source:"https://console.groq.com/docs/rate-limits"},
  {rank:5,slug:"openrouter-unlock",title:"OpenRouter Free + Funded",tagline:"Best multi-model access",whatYouGet:"50 free requests/day on 25+ models. Add $10 (spendable credit, does not expire) to unlock 1,000 free-model requests/day.",realNumbers:"Free tier: 50 RPD. Funded tier: 1,000 RPD. Credit remains usable for paid models too.",howToGetIt:"Sign up at openrouter.ai. To unlock: add $10+ credit balance.",whyItsGood:"Access many models through one API. The $10 unlock is spendable, not a fee.",catch:"Free-model requests only. Paid models cost extra on top of your balance.",bestFor:"Comparing models, flexible routing, low-volume multi-model use.",source:"https://openrouter.ai/pricing"}
];



function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

const dealCardsHtml = topDeals.map(d => `
  <div class="deal-full">
    <div class="deal-rank">#${d.rank}</div>
    <div class="deal-body">
      <div class="deal-head">
        <h3 class="deal-title"><a href="/deals/${d.slug}">${esc(d.title)}</a></h3>
        <span class="deal-tagline">${esc(d.tagline)}</span>
      </div>
      <div class="deal-section"><div class="deal-section-label">What you get</div><div class="deal-section-text">${esc(d.whatYouGet)}</div></div>
      <div class="deal-section"><div class="deal-section-label">Real numbers</div><div class="deal-section-text">${esc(d.realNumbers)}</div></div>
      <div class="deal-section"><div class="deal-section-label">How to get it</div><div class="deal-section-text">${esc(d.howToGetIt)}</div></div>
      <div class="deal-section"><div class="deal-section-label">Why it is good</div><div class="deal-section-text">${esc(d.whyItsGood)}</div></div>
      <div class="deal-section"><div class="deal-section-label">What to watch out for</div><div class="deal-section-text deal-catch">${esc(d.catch)}</div></div>
      <div class="deal-section"><div class="deal-section-label">Best for</div><div class="deal-section-text">${esc(d.bestFor)}</div></div>
      <div class="deal-footer"><a href="/deals/${d.slug}" class="deal-link">Full analysis</a> <span style="color:var(--border)">|</span> <a href="${d.source}" target="_blank" rel="noopener" class="deal-link">Official source</a></div>
    </div>
  </div>
`).join('');
---
<Base title="LLMDeals - The best AI deals right now">
  <section class="hero">
    <div class="eyebrow">Deal intelligence for AI</div>
    <h1>The best AI deals right now</h1>
    <p class="subtitle">We research pricing, subscriptions, free tiers and promotions and tell you which ones are actually worth using. Updated August 23, 2026.</p>
  </section>

  <section style="margin-bottom:56px">
    <div class="section-header">
      <h2>Best current deals</h2>
      <a href="/deals" class="see-all">View all deals</a>
    </div>
    <div class="deal-list" set:html={dealCardsHtml} />
  </section>

  <section style="margin-top:56px">
    <div class="section-header">
      <h2>All OpenCode Go model routes</h2>
      <span class="stats">{routeRows.length} OpenCode Go routes</span>
    </div>
    <p style="font-size:13px;color:var(--text-dim);margin-bottom:16px">
      <strong>Score</strong> = overall value ranking (quality x volume x economics). 
      <strong>Effective cost</strong> = what you actually pay per request after the $60 usage pool is applied.
    </p>
    <div class="toolbar">
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <div class="tabs" id="tabs">
          <button class="tab active" data-profile="overall">Overall</button>
          <button class="tab" data-profile="coding">Coding</button>
          <button class="tab" data-profile="agentic">Agents</button>
          <button class="tab" data-profile="research">Research</button>
        </div>
        <input type="search" id="q" placeholder="Search models..." />
        <select id="filter-role"><option value="">All roles</option>
          <option value="bulk_executor">Bulk executor</option>
          <option value="balanced">Balanced</option>
          <option value="orchestration">Orchestration</option>
          <option value="coding">Coding</option>
          <option value="reasoning">Reasoning</option>
          <option value="premium_reasoning">Premium reasoning</option>
        </select>
      </div>
    </div>
    <div class="table-wrap">
      <table id="routes-table">
        <thead><tr>
          <th data-col="overall" data-num title="Weighted: quality/cost/reliability/throughput - switch profiles above">Score</th>
          <th data-col="model">Model</th>
          <th data-col="ctx">Context</th>
          <th data-col="inP" data-num>List $/M In</th>
          <th data-col="outP" data-num>List $/M Out</th>
          <th data-col="effIn" data-num>Eff $/M In</th>
          <th data-col="effOut" data-num>Eff $/M Out</th>
          <th data-col="requests" data-num>Req/Mo</th>
          <th>Badges</th>
          <th data-col="role">Role</th>
        </tr></thead>
        <tbody id="routes-body"></tbody>
      </table>
    </div>
  </section>

  <script define:vars={{ allRoutes: JSON.stringify(routeRows.map(r => ({model:r.model,id:r.model_id,ctx:r.ctx,inP:r.list_input_per_m,outP:r.list_output_per_m,effIn:r.effective_input_per_m,effOut:r.effective_output_per_m,requests:r.requests_per_month,role:r.role,scores:r.scores.profiles,badges:r.badges}))) }}>
    const routes = JSON.parse(allRoutes);
    let sort = {col:'overall', dir:'desc'};
    let profile = 'overall';
    let filtered = [...routes];

    function cell(v) {
      if (v >= 80) return 'var(--accent)';
      if (v >= 65) return 'var(--blue)';
      if (v >= 50) return 'var(--yellow)';
      return 'var(--text-dim)';
    }

    function render() {
      const tbody = document.getElementById('routes-body');
      if (!tbody) return;
      const q = (document.getElementById('q')?.value||'').toLowerCase();
      const fr = document.getElementById('filter-role')?.value||'';
      filtered = routes.filter(r => {
        if (q && !(r.model+r.role+r.badges.join(' ')).toLowerCase().includes(q)) return false;
        if (fr && r.role !== fr) return false;
        return true;
      });
      filtered.sort((a,b) => sort.dir === 'asc' ? a[sort.col]-b[sort.col] : b[sort.col]-a[sort.col]);
      tbody.innerHTML = filtered.map(r => `<tr>
        <td class="price" style="color:${cell(r[profile])};font-size:16px;font-weight:800">${r[profile]}</td>
        <td><div class="model-name">${r.model}</div><div class="model-sub">${r.id}</div></td>
        <td style="font-size:12px;color:var(--text-dim)">${r.ctx}</td>
        <td style="font-size:11px;font-variant-numeric:tabular-nums">$${r.inP}</td>
        <td style="font-size:11px;font-variant-numeric:tabular-nums">$${r.outP}</td>
        <td style="font-size:11px;font-variant-numeric:tabular-nums;color:var(--accent);font-weight:600">$${Number(r.effIn).toFixed(5)}</td>
        <td style="font-size:11px;font-variant-numeric:tabular-nums;color:var(--accent);font-weight:600">$${Number(r.effOut).toFixed(5)}</td>
        <td style="font-size:12px;font-variant-numeric:tabular-nums">${r.requests ? r.requests.toLocaleString() : '-'}</td>
        <td>${r.badges.map(b=>`<span class="badge badge-type" style="margin-right:3px">${b}</span>`).join('')}</td>
        <td style="font-size:11px;color:var(--text-dim)">${(r.role||'').replace(/_/g,' ')}</td>
      </tr>`).join('');
      document.querySelectorAll('th[data-col]').forEach(th => {
        th.classList.remove('sorted-asc','sorted-desc');
        if (th.dataset.col === sort.col) th.classList.add('sorted-'+sort.dir);
      });
    }
    document.querySelectorAll('th[data-col]').forEach(th => {
      th.addEventListener('click', () => {
        const col = th.dataset.col;
        if (sort.col === col) sort.dir = sort.dir === 'asc' ? 'desc' : 'asc';
        else { sort.col = col; sort.dir = 'desc'; }
        render();
      });
    });
    document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
      t.classList.add('active');
      profile = t.dataset.profile;
      sort = {col:profile, dir:'desc'};
      render();
    }));
    document.getElementById('q')?.addEventListener('input', render);
    document.getElementById('filter-role')?.addEventListener('change', render);
    render();
  </script>
</Base>
