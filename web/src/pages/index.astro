  {model:"Llama 4 Maverick",id:"meta-llama/llama-4-maverick",provider:"openrouter",family:"Llama",ctx:"1M",inP:0.20,outP:0.60,cacheP:0.02,rpm:null,free:true,tools:true,json:true,vision:true,deal:"50 free req/day",source:"https://openrouter.ai/pricing"},
