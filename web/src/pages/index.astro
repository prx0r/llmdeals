function blended(inP, outP) { return inP + outP * 3; }
function priceClass(v) { return v === 0 ? 'price-free' : v < 1 ? 'price-low' : v < 5 ? 'price-mid' : 'price-high'; }
function fmtP(v) { return v === 0 ? 'Free' : v < 0.01 ? `$${v.toFixed(4)}` : `$${v.toFixed(2)}`; }
function dotClass(p) { return `dot-${p}`; }
function providerLabel(p) {
  const m = {opencode:'OpenCode',cloudflare:'Cloudflare',google_ai:'Google',groq:'Groq',openrouter:'OpenRouter',cerebras:'Cerebras',huggingface:'HuggingFace',github:'GitHub',mistral:'Mistral'};
  return m[p] || p;
}
---
<Base title="LLM Deals - Compare AI Model Pricing">
  <div class="hero">
    <div class="eyebrow">Compare AI API prices</div>
    <h1>Find the cheapest route for every model</h1>
    <p class="subtitle">Compare official API prices, subscription deals, and free tiers across 9 providers. All data verified from official sources.</p>
  </div>

  <div class="toolbar">
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <input type="search" id="q" placeholder="Search model, provider, or family..." />
      <select id="filter-provider"><option value="">All providers</option>
        <option value="opencode">OpenCode</option><option value="google_ai">Google</option>
        <option value="groq">Groq</option><option value="openrouter">OpenRouter</option>
      </select>
      <select id="filter-free"><option value="">All models</option>
        <option value="free">Free tier only</option><option value="paid">Paid only</option>
      </select>
    </div>
    <div class="stats" id="stats"></div>
  </div>

  <div class="table-wrap">
    <table id="main-table">
      <thead>
        <tr>
          <th data-col="model">Model</th>
          <th data-col="provider">Provider</th>
          <th data-col="family">Family</th>
          <th data-col="ctx">Context</th>
          <th data-col="inP" data-num>Input $/M</th>
          <th data-col="outP" data-num>Output $/M</th>
          <th data-col="blended" data-num>Blended</th>
          <th data-col="rpm" data-num>Req/Mo</th>
          <th data-col="features">Features</th>
          <th data-col="deal">Deal</th>
        </tr>
      </thead>
      <tbody id="tbody"></tbody>
    </table>
  </div>

  <div class="section-gap">
    <h2>Top subscription deals</h2>
    <p class="subtitle" style="margin-bottom:20px">Deterministic economics from verified provider facts. No LLM inference.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px">
      <div class="deal-card">
        <div class="deal-provider"><span class="provider-badge"><span class="provider-dot dot-opencode"></span>OpenCode</span></div>
        <div class="deal-title" style="margin-top:8px">OpenCode Go</div>
        <div class="deal-terms">$5 first month, then $10/mo. $60/mo usage pool across 21+ models.</div>
        <div class="deal-value">6x</div>
        <div class="deal-meta"><span class="badge badge-deal">subscription_usage_pool</span><span>intro: 12x</span><span>renewal: 6x</span></div>
      </div>
      <div class="deal-card">
        <div class="deal-provider"><span class="provider-badge"><span class="provider-dot dot-cloudflare"></span>Cloudflare</span></div>
        <div class="deal-title" style="margin-top:8px">Workers AI Free</div>
        <div class="deal-terms">10,000 neurons/day free. $0.011/1K neurons if you exceed.</div>
        <div class="deal-value">$3.30<span style="font-size:14px;color:var(--text-muted)">/mo equiv.</span></div>
        <div class="deal-meta"><span class="badge badge-free">recurring_free_quota</span><span>resets daily</span></div>
      </div>
      <div class="deal-card">
        <div class="deal-provider"><span class="provider-badge"><span class="provider-dot dot-github"></span>GitHub</span></div>
        <div class="deal-title" style="margin-top:8px">Copilot Pro / Pro+ / Max</div>
        <div class="deal-terms">$10=1,500 credits (1.5x), $39=7,000 (1.8x), $100=20,000 (2x). Unlimited completions included.</div>
        <div class="deal-value">1.5-2x</div>
        <div class="deal-meta"><span class="badge badge-deal">subscription_credit_pool</span><span>1 credit = $0.01</span></div>
      </div>
      <div class="deal-card">
        <div class="deal-provider"><span class="provider-badge"><span class="provider-dot dot-openrouter"></span>OpenRouter</span></div>
        <div class="deal-title" style="margin-top:8px">Free + Funded Unlock</div>
        <div class="deal-terms">50 free req/day. Add $10 balance (spendable) to unlock 1,000 req/day on free models.</div>
        <div class="deal-value">20x<span style="font-size:14px;color:var(--text-muted)"> free quota</span></div>
        <div class="deal-meta"><span class="badge badge-type">balance_threshold_unlock</span><span>balance doesn't expire</span></div>
      </div>
    </div>
  </div>

  <script define:vars={{ allModels: JSON.stringify(allModels) }}>
    const models = JSON.parse(allModels);
    let sort = {col:'blended', dir:'asc'};
    let filtered = [...models];

    function blended(inP, outP) { return inP + outP * 3; }
    function priceClass(v) { return v === 0 ? 'price-free' : v < 1 ? 'price-low' : v < 5 ? 'price-mid' : 'price-high'; }
    function fmtP(v) { return v === 0 ? 'Free' : v < 0.01 ? '$'+v.toFixed(4) : '$'+v.toFixed(2); }
    function dotClass(p) { return 'dot-'+p; }
    function providerLabel(p) {
      return {opencode:'OpenCode',cloudflare:'Cloudflare',google_ai:'Google',groq:'Groq',openrouter:'OpenRouter'}[p]||p;
    }

    function render() {
      const tbody = document.getElementById('tbody');
      if (!tbody) return;

      const q = (document.getElementById('q')?.value||'').toLowerCase();
      const fp = document.getElementById('filter-provider')?.value||'';
      const ff = document.getElementById('filter-free')?.value||'';

      filtered = models.filter(m => {
        if (q && !(m.model+m.id+m.provider+m.family+m.deal).toLowerCase().includes(q)) return false;
        if (fp && m.provider !== fp) return false;
        if (ff === 'free' && !m.free) return false;
        if (ff === 'paid' && m.free) return false;
        return true;
      });

      filtered.sort((a,b) => {
        let va, vb;
        if (sort.col === 'blended') { va = blended(a.inP, a.outP); vb = blended(b.inP, b.outP); }
        else if (sort.col === 'rpm') { va = a.rpm||999999; vb = b.rpm||999999; }
        else if (['inP','outP'].includes(sort.col)) { va = a[sort.col]; vb = b[sort.col]; }
        else { va = a[sort.col]||''; vb = b[sort.col]||''; }
        if (typeof va === 'string') return sort.dir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
        return sort.dir === 'asc' ? va-vb : vb-va;
      });

      tbody.innerHTML = filtered.map(m => {
        const bl = blended(m.inP, m.outP);
        const features = [];
        if (m.tools) features.push('<span class="badge badge-verified">Tools</span>');
        if (m.vision) features.push('<span class="badge badge-verified">Vision</span>');
        if (m.json) features.push('<span class="badge badge-verified">JSON</span>');
        const dealBadge = m.free ? '<span class="badge badge-free">Free</span>' : '';
        return `<tr>
          <td><div class="model-name">${m.model}</div><div class="model-sub">${m.id}</div></td>
          <td><span class="provider-badge"><span class="provider-dot ${dotClass(m.provider)}"></span>${providerLabel(m.provider)}</span></td>
          <td style="color:var(--text-dim);font-size:12px">${m.family}</td>
          <td style="font-size:12px">${m.ctx}</td>
          <td class="price ${priceClass(m.inP)}">${fmtP(m.inP)}</td>
          <td class="price ${priceClass(m.outP)}">${fmtP(m.outP)}</td>
          <td class="price ${priceClass(bl)}"><strong>${fmtP(bl)}</strong></td>
          <td style="font-size:12px;font-variant-numeric:tabular-nums">${m.rpm ? m.rpm.toLocaleString() : '—'}</td>
          <td>${features.join(' ')}</td>
          <td>${dealBadge} <span style="font-size:11px;color:var(--text-dim)">${m.deal}</span></td>
        </tr>`;
      }).join('');

      const provCount = new Set(filtered.map(m=>m.provider)).size;
      document.getElementById('stats').textContent = `${filtered.length} models · ${provCount} providers`;

      document.querySelectorAll('th[data-col]').forEach(th => {
        th.classList.remove('sorted-asc','sorted-desc');
        if (th.dataset.col === sort.col) th.classList.add('sorted-'+sort.dir);
      });
    }

    document.querySelectorAll('th[data-col]').forEach(th => {
      th.addEventListener('click', () => {
        const col = th.dataset.col;
        if (sort.col === col) sort.dir = sort.dir === 'asc' ? 'desc' : 'asc';
        else { sort.col = col; sort.dir = 'asc'; }
        render();
      });
    });

    document.getElementById('q')?.addEventListener('input', render);
    document.getElementById('filter-provider')?.addEventListener('change', render);
    document.getElementById('filter-free')?.addEventListener('change', render);

    render();
  </script>
</Base>
