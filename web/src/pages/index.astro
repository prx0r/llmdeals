  {model:"GPT-OSS 120B",id:"openai/gpt-oss-120b",provider:"groq",family:"GPT",ctx:"8K",inP:0.15,outP:0.60,cacheP:null,rpm:30,free:true,tools:false,json:true,vision:false,deal:"Free tier",source:"https://console.groq.com/docs/rate-limits"},
