  {model:"GPT-5.6 Luna",id:"gpt-5.6-luna",provider:"opencode",family:"GPT",ctx:"128K",inP:0.25,outP:1.00,cacheP:0.025,rpm:10250,free:true,tools:true,json:true,vision:true,deal:"OpenCode Go $10/mo",source:"https://opencode.ai/docs/go/"},
  {model:"GLM 5.3",id:"glm-5.3",provider:"opencode",family:"GLM",ctx:"128K",inP:0.28,outP:0.56,cacheP:0.028,rpm:1080,free:true,tools:true,json:true,vision:false,deal:"OpenCode Go $10/mo",source:"https://opencode.ai/docs/go/"},
  {model:"HY3",id:"hy3",provider:"opencode",family:"HY",ctx:"128K",inP:0.10,outP:0.20,cacheP:0.01,rpm:21500,free:true,tools:true,json:true,vision:false,deal:"OpenCode Go $10/mo",source:"https://opencode.ai/docs/go/"},
  {model:"MiniMax M3",id:"minimax-m3",provider:"opencode",family:"MiniMax",ctx:"128K",inP:0.14,outP:0.28,cacheP:0.014,rpm:16000,free:true,tools:true,json:true,vision:false,deal:"OpenCode Go $10/mo",source:"https://opencode.ai/docs/go/"},
  {model:"Grok 4.5",id:"grok-4.5",provider:"opencode",family:"Grok",ctx:"128K",inP:0.50,outP:2.00,cacheP:0.05,rpm:600,free:true,tools:true,json:true,vision:true,deal:"OpenCode Go $10/mo",source:"https://opencode.ai/docs/go/"},
  {model:"Gemini 2.5 Flash",id:"gemini-2.5-flash",provider:"google_ai",family:"Gemini",ctx:"1M",inP:0.15,outP:0.60,cacheP:0.0375,rpm:null,free:true,tools:true,json:true,vision:true,deal:"Free tier",source:"https://ai.google.dev/gemini-api/docs/pricing"},
