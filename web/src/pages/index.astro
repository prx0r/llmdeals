  {model:"DeepSeek V4 Flash",id:"deepseek-v4-flash",provider:"opencode",family:"DeepSeek",ctx:"128K",inP:0.14,outP:0.28,cacheP:0.014,rpm:37800,free:true,tools:true,json:true,vision:false,deal:"OpenCode Go $10/mo",source:"https://opencode.ai/docs/go/"},
