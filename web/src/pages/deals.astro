---
<Base title="All Deals - LLMDeals">
  <section class="hero">
    <div class="eyebrow">Complete database</div>
    <h1>All AI deals</h1>
    <p class="subtitle">${deals.length} deals across 9 providers. Searchable and filterable.</p>
  </section>

  <div class="toolbar">
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <input type="search" id="q" placeholder="Search model, provider, or deal..." />
      <select id="filter-type"><option value="">All types</option>
        <option value="subscription">Subscription</option>
        <option value="free">Free</option>
        <option value="promo">Promo</option>
        <option value="unlock">Unlock</option>
      </select>
      <select id="filter-rating"><option value="">All ratings</option>
        <option value="exceptional">Exceptional</option>
        <option value="excellent">Excellent</option>
        <option value="good">Good</option>
        <option value="niche">Niche</option>
      </select>
    </div>
    <div class="stats" id="stats"></div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th data-col="score" data-num>Score</th>
          <th data-col="model">Model / Product</th>
          <th data-col="provider">Provider</th>
          <th data-col="deal_type">Type</th>
          <th data-col="price">Price</th>
          <th data-col="value">Value</th>
          <th data-col="rating">Rating</th>
        </tr>
      </thead>
      <tbody id="tbody"></tbody>
    </table>
  </div>

  <script define:vars={{ deals: JSON.stringify(deals) }}>
    const all = JSON.parse(deals);
    let sort = {col:'score', dir:'desc'};
    let filtered = [...all];

    function render() {
      const tbody = document.getElementById('tbody');
      if (!tbody) return;

      const q = (document.getElementById('q')?.value||'').toLowerCase();
      const ft = document.getElementById('filter-type')?.value||'';
      const fr = document.getElementById('filter-rating')?.value||'';

      filtered = all.filter(d => {
        if (q && !(d.model+d.provider+d.product+d.why+d.bestFor).toLowerCase().includes(q)) return false;
        if (ft && d.deal_type !== ft) return false;
        if (fr && d.rating !== fr) return false;
        return true;
      });

      filtered.sort((a,b) => {
        let va = a[sort.col], vb = b[sort.col];
        if (typeof va === 'string') return sort.dir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
        return sort.dir === 'asc' ? (va||0)-(vb||0) : (vb||0)-(va||0);
      });

      const ratingColors = {exceptional:'var(--accent)',excellent:'var(--blue)',good:'var(--yellow)',niche:'var(--text-dim)'};
      const typeLabels = {subscription:'Subscription',free:'Free',promo:'Promo',unlock:'Unlock'};

      tbody.innerHTML = filtered.map(d => `<tr style="cursor:pointer" onclick="window.location='/deals/${d.id}'">
        <td class="price" style="color:var(--accent);font-size:16px;font-weight:800">${d.score||'—'}</td>
        <td><div class="model-name">${d.model}</div><div class="model-sub">${d.product}</div></td>
        <td style="font-size:12px;color:var(--text-dim)">${d.provider}</td>
        <td><span class="badge badge-deal">${typeLabels[d.deal_type]||d.deal_type}</span></td>
        <td style="font-size:12px">${d.price_recurring > 0 ? '$'+d.price_recurring+'/mo' : d.price_intro > 0 ? '$'+d.price_intro+' intro' : 'Free'}</td>
        <td><span class="badge badge-verified">${d.value}</span></td>
        <td><span style="color:${ratingColors[d.rating]||'var(--text-dim)'};font-size:12px;font-weight:600;text-transform:capitalize">${d.rating}</span></td>
      </tr>`).join('');

      document.getElementById('stats').textContent = `${filtered.length} deals`;
      document.querySelectorAll('th[data-col]').forEach(th => {
        th.classList.remove('sorted-asc','sorted-desc');
        if (th.dataset.col === sort.col) th.classList.add('sorted-'+sort.dir);
      });
    }

    document.querySelectorAll('th[data-col]').forEach(th => {
      th.addEventListener('click', () => {
        const col = th.dataset.col;
        if (sort.col === col) sort.dir = sort.dir === 'asc' ? 'desc' : 'asc';
        else { sort.col = col; sort.dir = col === 'score' ? 'desc' : 'asc'; }
        render();
      });
    });

    document.getElementById('q')?.addEventListener('input', render);
    document.getElementById('filter-type')?.addEventListener('change', render);
    document.getElementById('filter-rating')?.addEventListener('change', render);

    render();
  </script>
</Base>
