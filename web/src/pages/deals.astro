---
import Base from '../layouts/Base.astro';
import derived from '../data/deals-derived.json';

const rows = derived.deals.map(d => ({
  slug:d.slug, title:d.title, model:d.model, provider:d.provider,
  deal_type:d.deal_type, label:d.label,
  price_recurring:d.price_recurring_usd ?? 0, price_intro:d.price_intro_usd ?? 0,
  requests:d.requests_per_month, value:d.ongoing_value_multiple ? `${d.ongoing_value_multiple}x` : (d.badges.includes('Free') ? 'Free' : '—'),
  rating:d.rating, score:d.rank_score, overall:d.scores.profiles.overall,
  badges:d.badges, why:d.why_good,
}));
---
<Base title="All Deals - LLMDeals">
  <section class="hero">
    <div class="eyebrow">Complete database</div>
    <h1>All AI deals</h1>
    <p class="subtitle">{rows.length} deal routes across {derived.counts.providers} providers. Every row links to full analysis with the math and evidence.</p>
  </section>

  <div class="toolbar">
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <input type="search" id="q" placeholder="Search model, provider..." />
      <select id="filter-type"><option value="">All types</option>
        <option value="subscription">Subscription</option><option value="free">Free</option>
        <option value="promo">Promo</option><option value="unlock">Unlock</option>
      </select>
      <select id="filter-rating"><option value="">All ratings</option>
        <option value="exceptional">Exceptional</option><option value="excellent">Excellent</option>
        <option value="good">Good</option><option value="niche">Niche</option>
      </select>
    </div>
    <div class="stats" id="stats"></div>
  </div>

  <div class="table-wrap">
    <table>
      <thead><tr>
        <th data-col="overall" data-num>Score</th>
        <th>Deal</th>
        <th>Provider</th>
        <th data-col="label">Type</th>
        <th data-col="price" data-num>Price</th>
        <th>Value</th>
        <th data-col="rating">Rating</th>
      </tr></thead>
      <tbody id="tbody"></tbody>
    </table>
  </div>

  <script define:vars={{ rows: JSON.stringify(rows) }}>
    const all = JSON.parse(rows);
    let sort = {col:'overall', dir:'desc'};
    let filtered = [...all];

    const rc = {exceptional:'var(--accent)',excellent:'var(--blue)',good:'var(--yellow)',niche:'var(--text-dim)'};
    const tl = {subscription:'Subscription',free:'Free',promo:'Promo',unlock:'Unlock'};

    function render() {
      const tbody = document.getElementById('tbody');
      if (!tbody) return;
      const q = (document.getElementById('q')?.value||'').toLowerCase();
      const ft = document.getElementById('filter-type')?.value||'';
      const fr = document.getElementById('filter-rating')?.value||'';
      filtered = all.filter(d => {
        if (q && !(d.title+d.provider+(d.why||'')+d.badges.join(' ')).toLowerCase().includes(q)) return false;
        if (ft && d.deal_type !== ft) return false;
        if (fr && d.rating !== fr) return false;
        return true;
      });
      filtered.sort((a,b) => {
        let va=a[sort.col]??-1, vb=b[sort.col]??-1;
        if (typeof va === 'string') return sort.dir==='asc' ? va.localeCompare(vb) : vb.localeCompare(va);
        return sort.dir==='asc' ? va-vb : vb-va;
      });
      tbody.innerHTML = filtered.map(d => `<tr style="cursor:pointer" onclick="window.location='/deals/${d.slug}'">
        <td class="price" style="color:${d.score?'var(--accent)':'var(--text-dim)'};font-weight:800">${d.score??'—'}</td>
        <td><div class="model-name">${d.title}</div>${d.badges.map(b=>`<span class="badge badge-type" style="margin:3px 3px 0 0">${b}</span>`).join('')}</td>
        <td style="font-size:12px;color:var(--text-dim)">${d.provider}</td>
        <td><span class="badge badge-deal">${tl[d.deal_type]||d.deal_type}</span></td>
        <td style="font-size:12px">${d.price_recurring > 0 ? '$'+d.price_recurring+'/mo' : d.price_intro > 0 ? '$'+d.price_intro : 'Free'}</td>
        <td><span class="badge badge-verified">${d.value}</span></td>
        <td><span style="color:${rc[d.rating]||'var(--text-dim)'};font-size:12px;font-weight:600;text-transform:capitalize">${d.rating}</span></td>
      </tr>`).join('');
      document.getElementById('stats').textContent = filtered.length + ' deals';
    }
    document.querySelectorAll('th[data-col]').forEach(th => th.addEventListener('click', () => {
      const col = th.dataset.col;
      if (sort.col === col) sort.dir = sort.dir==='asc'?'desc':'asc';
      else { sort.col = col; sort.dir = 'desc'; }
      render();
    }));
    document.getElementById('q')?.addEventListener('input', render);
    document.getElementById('filter-type')?.addEventListener('change', render);
    document.getElementById('filter-rating')?.addEventListener('change', render);
    render();
  </script>
</Base>
